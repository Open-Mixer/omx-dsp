#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 Pau Aliagas <linuxnow@gmail.com>

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

include /usr/share/dpkg/architecture.mk

%:
	dh $@

override_dh_auto_build:
	dh_auto_build -- lib rt-gate-ship rta-read wasm

override_dh_auto_install:
	dh_auto_install -- PREFIX=/usr LIBDIR=/usr/lib/$(DEB_HOST_MULTIARCH) INCLUDEDIR=/usr/include install-wasm

# The gate and the reader are packages of their own, omx-rt-gate and omx-rta-read: an executable has no
# place in libomxdsp-dev, which is Multi-Arch: same, and only the reader needs JACK. libomxdsp-dev.install
# takes whole directories (usr/bin, usr/share/man, usr/share/omxdsp), so its dh_install leaves out every
# path that names either.
override_dh_install:
	dh_install -Nomx-rt-gate -Nomx-rta-read -Nomx-dsp-wasm -Xrt-gate -Xomx-rta-read
	dh_install -pomx-rt-gate
	dh_install -pomx-rta-read
	dh_install -pomx-dsp-wasm

# The package's check is make check-package (the tests that prove the built library; the sabotage and
# perturbation arms run in CI's make test), one make job per CPU dpkg-buildpackage was given
# (DEB_BUILD_OPTIONS parallel=N), as the RPM's %check does (BUILDING.md).
NUMJOBS = $(patsubst parallel=%,%,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	$(MAKE) $(addprefix -j,$(NUMJOBS)) check-package
endif

# libomxdsp API reference: every installed header (include/omxdsp and its fx/, mix/ and analysis/).
# Build-time only: `make docs`; never a runtime dependency of the console.
# The documentation gate is `make docs-check`: doxygen's own undocumented-member and parameter warnings
# (WARN_IF_UNDOCUMENTED, WARN_NO_PARAMDOC) are written to WARN_LOGFILE and compared with
# docs/doxygen-baseline.txt, the undocumented public declarations the tree still carries. A warning not
# in the baseline is red; a baseline row no longer warned is red (drop it); a baseline that grew against
# its base is red. WARN_FORMAT carries no $line, so a row names the header and the declaration only, and
# docs-check strips the tree's own path from it, so a row reads the same in every checkout.
PROJECT_NAME           = libomxdsp
PROJECT_BRIEF          = "openmixer's DSP primitives: one header per building block"
OUTPUT_DIRECTORY       = build/docs
INPUT                  = include/omxdsp
# rendered from data/, where every define is documented (its definition); the banner says so
EXCLUDE                = include/omxdsp/omxdsp_definitions.h
FILE_PATTERNS          = *.h
RECURSIVE              = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
WARN_FORMAT            = "$file: $text"
WARN_LOGFILE           = build/docs/warnings.txt
QUIET                  = YES
GENERATE_HTML          = YES
GENERATE_MAN           = YES
MAN_LINKS              = NO
GENERATE_LATEX         = NO
SOURCE_BROWSER         = NO
ALPHABETICAL_INDEX     = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = OMX_CONTRACTS __x86_64__ "__attribute__(x)=" "OMXDSP_STATIC_ASSERT(c,m)="
ALIASES               += "pre=\par Precondition:^^" \
                         "post=\par Postcondition:^^" \
                         "invariant=\par Invariant:^^" \
                         "twin=\par Twin in TypeScript:^^" \
                         "thread=\par Thread:^^"
HAVE_DOT               = NO
EXCLUDE_SYMBOLS        = OMX_CONTRACT_STAGE M_PI
